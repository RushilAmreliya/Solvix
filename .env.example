# NowCast Fusion Environment Configuration
# Copy this file to .env and adjust values as needed.

# Server settings
API_HOST=0.0.0.0
API_PORT=8000

# CORS Origins (comma-separated or * for all)
CORS_ORIGINS=*

# Ingest and forecast sequence configuration
SEQ_IN=3
MAX_BUFFER=20
CNN_BLEND=0.30

# Optional custom paths
# DATA_DIR=./data
# MODEL_PATH=./backend/engine/nowcast_model.pth
